    "policy",
    "eu-ai-act",
    "github-action",
    "sonarqube-for-ai"
  ],
  "homepage": "https://www.aibvf.com/protocol",
  "repository": "github:Craig-Horton/ai-bvf",
  "license": "MIT",
  "author": "Craig Horton",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aibvf-check": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@aibvf/core": "^0.8.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^26.4.0"
  }
}